{
 "schema_version": "legion.world.v1",
 "world_id": "SYN-GAIA-EXE-W1",
 "family": "SYN-GAIA-EXE",
 "source_family": "GAIA2_STRUCTURAL",
 "mission_text": "Fulfil every open order that can be fulfilled from current stock (reserve exactly the ordered quantity, then ship); orders that cannot be fulfilled must be backordered. Do not touch stock you do not need.",
 "initial_state": {
  "inventory": {
   "sku_a": 5,
   "sku_b": 0,
   "sku_c": 3
  },
  "inventory_meta": {
   "sku_a": {
    "name": "USB-C dock"
   },
   "sku_b": {
    "name": "4K monitor"
   },
   "sku_c": {
    "name": "keyboard"
   }
  },
  "orders": {
   "ord_1": {
    "sku": "sku_a",
    "qty": 2,
    "status": "new"
   },
   "ord_2": {
    "sku": "sku_c",
    "qty": 1,
    "status": "new"
   },
   "ord_3": {
    "sku": "sku_b",
    "qty": 1,
    "status": "new"
   }
  },
  "shipments": []
 },
 "tools": {
  "orders.list": {
   "kind": "read",
   "doc": "List all open orders with sku, qty and status.",
   "params": {},
   "returns": {
    "orders": "orders"
   }
  },
  "inventory.get": {
   "kind": "read",
   "doc": "Stock level for one sku.",
   "params": {
    "sku": {
     "type": "string",
     "enum": [
      "sku_a",
      "sku_b",
      "sku_c"
     ]
    }
   },
   "returns": {
    "sku": "inventory_meta.{sku}.name",
    "on_hand": "inventory.{sku}"
   }
  },
  "inventory.reserve": {
   "kind": "write",
   "doc": "Reserve stock for an order: decrements inventory[sku] by qty and marks the order reserved.",
   "params": {
    "order_id": {
     "type": "string",
     "enum": [
      "ord_1",
      "ord_2",
      "ord_3"
     ]
    },
    "sku": {
     "type": "string",
     "enum": [
      "sku_a",
      "sku_b",
      "sku_c"
     ]
    },
    "qty": {
     "type": "integer",
     "min": 1,
     "max": 10
    }
   },
   "target": "{order_id}",
   "native_preconditions": [
    {
     "path": "inventory.{sku}",
     "op": "ge",
     "value": 1
    },
    {
     "path": "orders.{order_id}.status",
     "op": "eq",
     "value": "new"
    }
   ],
   "effects": [
    {
     "op": "inc",
     "path": "inventory.{sku}",
     "value": {
      "param": "qty",
      "negate": true
     }
    },
    {
     "op": "set",
     "path": "orders.{order_id}.status",
     "value": "reserved"
    },
    {
     "op": "set",
     "path": "orders.{order_id}.reserved_qty",
     "value": {
      "param": "qty"
     }
    }
   ]
  },
  "orders.backorder": {
   "kind": "write",
   "doc": "Mark an order as backordered (no stock movement).",
   "params": {
    "order_id": {
     "type": "string",
     "enum": [
      "ord_1",
      "ord_2",
      "ord_3"
     ]
    }
   },
   "target": "{order_id}",
   "native_preconditions": [
    {
     "path": "orders.{order_id}.status",
     "op": "eq",
     "value": "new"
    }
   ],
   "effects": [
    {
     "op": "set",
     "path": "orders.{order_id}.status",
     "value": "backordered"
    }
   ]
  },
  "shipping.create": {
   "kind": "write",
   "doc": "Create a shipment for a reserved order.",
   "params": {
    "order_id": {
     "type": "string",
     "enum": [
      "ord_1",
      "ord_2",
      "ord_3"
     ]
    }
   },
   "target": "ship-{order_id}",
   "native_preconditions": [
    {
     "path": "orders.{order_id}.status",
     "op": "eq",
     "value": "reserved"
    }
   ],
   "effects": [
    {
     "op": "set",
     "path": "orders.{order_id}.status",
     "value": "shipped"
    },
    {
     "op": "append",
     "path": "shipments",
     "value": {
      "param": "order_id"
     }
    }
   ]
  }
 },
