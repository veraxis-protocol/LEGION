      "P1",
      "P2",
      "P3"
     ]
    }
   },
   "returns": {
    "product": "catalog_view.{product_id}"
   }
  },
  "catalog.rebuild_entry": {
   "kind": "write",
   "doc": "Rebuild one product's catalog entry from the source of truth.",
   "params": {
    "product_id": {
     "type": "string",
     "enum": [
      "P1",
      "P2",
      "P3"
     ]
    }
   },
   "target": "{product_id}",
   "native_preconditions": [],
   "effects": [
    {
     "op": "set",
     "path": "catalog.{product_id}.read_error",
     "value": false
    },
    {
     "op": "inc",
     "path": "catalog.{product_id}.version",
     "value": 1
    },
    {
     "op": "set",
     "path": "catalog_view.{product_id}.status",
     "value": "ok"
    }
   ]
  }
 },
