   "params": {
    "group": {
     "type": "string",
     "enum": [
      "fraud-detection"
     ]
    }
   },
   "target": "cg-fraud-detection",
   "native_preconditions": [
    {
     "path": "group.state",
     "op": "eq",
     "value": "dead"
