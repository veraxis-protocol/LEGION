     "value": "running"
    }
   ]
  },
  "partition.drain": {
   "kind": "write",
   "doc": "Consume a partition from 'from_offset' to log end in order and commit. from_offset must equal the committed offset.",
   "params": {
    "partition": {
     "type": "string",
     "enum": [
      "p0",
      "p1",
      "p2",
      "p3",
      "p4",
      "p5",
      "p6",
      "p7",
      "p8",
      "p9"
     ]
    },
    "from_offset": {
     "type": "integer",
     "min": 0,
     "max": 1000
    }
   },
   "target": "{partition}",
   "native_preconditions": [
    {
     "path": "group.state",
     "op": "eq",
     "value": "running"
    },
    {
     "path": "partitions.{partition}.committed",
     "op": "eq",
     "value": {
      "param": "from_offset"
     }
    }
   ],
   "effects": [
    {
     "op": "inc",
     "path": "processed.{partition}",
     "value": {
      "path_minus_param": [
       "partitions.{partition}.log_end",
       "from_offset"
      ]
     }
    },
    {
     "op": "set",
     "path": "partitions.{partition}.committed",
     "value": {
      "path": "partitions.{partition}.log_end"
     }
    },
    {
     "op": "set",
     "path": "lag.{partition}",
     "value": 0
    },
    {
     "op": "inc",
     "path": "drains.{partition}",
     "value": 1
    }
   ]
  }
 },
